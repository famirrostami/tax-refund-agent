# Pick ONE way to run the model. Keys stay on the server and are never committed.
# The app behaves the same either way.
#
# A) API key
LLM_PROVIDER=anthropic        # anthropic | openai | ollama | claude-code
LLM_MODEL=claude-sonnet-5-5   # optional; each provider has a default
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
#
# B) Your Claude subscription through the Claude Code CLI (no API key; `claude` must be installed and logged in)
# LLM_PROVIDER=claude-code
# LLM_MODEL=sonnet            # sonnet | opus | haiku

COUNTRY=de
DATA_DIR=./data
